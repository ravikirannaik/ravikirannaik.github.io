---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  {% if page.collection == "teachings" %}
    <a class="back-link" href="{{ '/teaching/' | relative_url }}">← Back to Teaching</a>
  {% endif %}
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  {% if page.collection == "teachings" %}
    <div class="row course-shell">
      <aside class="col-lg-3 d-none d-lg-block course-nav-col">
        {% include course-sidebar.liquid %}
      </aside>
      <div class="col-lg-9 course-main">
        <article>
          {{ content }}
        </article>
        {% if page.last_updated %}
          <p class="course-last-updated text-muted mt-4 mb-0">
            <small>Last updated on {{ page.last_updated }}</small>
          </p>
        {% endif %}
        {% include course-pager.liquid %}
      </div>
    </div>
  {% else %}
    <article>
      {{ content }}
    </article>
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
