<style>
  .course-pager {
    display: flex; justify-content: space-between; gap: 1rem;
    margin-top: 2.5rem; padding-top: 1.25rem;
    border-top: 1px solid var(--global-divider-color);
  }
  .course-pager > div { flex: 1 1 0; min-width: 0; }
  .course-pager .course-pager-next { text-align: right; }
  .course-pager a {
    display: inline-block; text-decoration: none;
    color: var(--global-text-color); max-width: 100%;
  }
  .course-pager a:hover { text-decoration: none; }
  .course-pager a:hover .course-pager-title { color: var(--global-theme-color); }
  .course-pager .course-pager-dir {
    display: block; font-size: 0.72rem; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--global-text-color-light);
  }
  .course-pager .course-pager-title {
    display: block; font-weight: 600; line-height: 1.25;
  }
</style>
{% assign sorted_courses = site.teachings | sort: 'importance' %}
{% assign total = sorted_courses | size %}
{% assign cur = 0 %}
{% for course in sorted_courses %}
  {% if course.url == page.url %}{% assign cur = forloop.index0 %}{% endif %}
{% endfor %}
{% assign prev_i = cur | minus: 1 %}
{% assign next_i = cur | plus: 1 %}
<nav class="course-pager" aria-label="Course navigation">
  <div class="course-pager-prev">
    {% if cur > 0 %}
      {% assign p = sorted_courses[prev_i] %}
      <a href="{{ p.url | relative_url }}">
        <span class="course-pager-dir">&larr; Previous</span>
        <span class="course-pager-title">{{ p.title }}</span>
      </a>
    {% endif %}
  </div>
  <div class="course-pager-next">
    {% if next_i < total %}
      {% assign n = sorted_courses[next_i] %}
      <a href="{{ n.url | relative_url }}">
        <span class="course-pager-dir">Next &rarr;</span>
        <span class="course-pager-title">{{ n.title }}</span>
      </a>
    {% endif %}
  </div>
</nav>
