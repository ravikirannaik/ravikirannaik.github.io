<style>
  .course-nav { position: sticky; top: 5rem; }
  .course-nav .course-nav-title {
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.07em;
    font-weight: 700; color: var(--global-text-color-light);
    margin-bottom: 0.6rem;
  }
  .course-nav ul { list-style: none; padding-left: 0; margin: 0; }
  .course-nav li { margin: 0; }
  .course-nav a {
    display: block; padding: 0.4rem 0.7rem; border-radius: 6px;
    color: var(--global-text-color); text-decoration: none; line-height: 1.3;
    border-left: 2px solid transparent;
  }
  .course-nav a:hover { background: rgba(0, 0, 0, 0.04); text-decoration: none; }
  .course-nav a.active {
    background: rgba(95, 116, 160, 0.12);
    color: var(--global-theme-color); font-weight: 600;
    border-left-color: var(--global-theme-color);
  }
  .course-nav .course-nav-term {
    display: block; font-size: 0.72rem; font-weight: 400;
    color: var(--global-text-color-light);
  }
  /* Main (h2) sections of the active course, nested under its entry */
  .course-nav .course-nav-sections {
    margin: 0.15rem 0 0.5rem 0.8rem;
    padding-left: 0.6rem;
    border-left: 2px solid var(--global-divider-color);
  }
  .course-nav a.course-nav-sec {
    padding: 0.25rem 0.55rem; font-size: 0.82rem; line-height: 1.25;
    color: var(--global-text-color-light); margin-left: -0.62rem;
  }
  .course-nav a.course-nav-sec:hover { background: rgba(0, 0, 0, 0.04); color: var(--global-text-color); }
  .course-nav a.course-nav-sec.active {
    background: rgba(95, 116, 160, 0.12);
    color: var(--global-theme-color); font-weight: 600;
    border-left-color: var(--global-theme-color);
  }
</style>
<nav class="course-nav">
  <div class="course-nav-title">Courses</div>
  <ul>
    {% assign sorted_courses = site.teachings | sort: 'importance' %}
    {% for course in sorted_courses %}
      <li>
        <a href="{{ course.url | relative_url }}"{% if course.url == page.url %} class="active" aria-current="page"{% endif %}>
          {{ course.title }}
          {% if course.term %}<span class="course-nav-term">{{ course.term }}</span>{% endif %}
        </a>
        {% if course.url == page.url %}
          <ul class="course-nav-sections" id="course-nav-sections"></ul>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>

<script>
  // Build a jump-list of the active course's MAIN (h2) sections and
  // highlight the current one as the reader scrolls.
  (function () {
    var box = document.getElementById('course-nav-sections');
    if (!box) return;
    var content = document.querySelector('.course-main article') || document.querySelector('.post article');
    if (!content) { box.remove(); return; }
    var heads = content.querySelectorAll('h2[id]');
    if (!heads.length) { box.remove(); return; }

    var byId = {};
    heads.forEach(function (h) {
      var a = document.createElement('a');
      a.href = '#' + h.id;
      a.className = 'course-nav-sec';
      a.textContent = (h.textContent || '').replace(/[¶#]+\s*$/, '').trim();
      box.appendChild(a);
      byId[h.id] = a;
    });

    var current = null;
    function setActive(id) {
      var a = byId[id];
      if (!a || a === current) return;
      if (current) current.classList.remove('active');
      a.classList.add('active');
      current = a;
    }
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) setActive(e.target.id); });
    }, { rootMargin: '-80px 0px -70% 0px', threshold: 0 });
    heads.forEach(function (h) { obs.observe(h); });
    setActive(heads[0].id);
  })();
</script>
