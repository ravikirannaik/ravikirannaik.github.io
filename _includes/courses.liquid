{% if site.teachings %}
  <div class="courses accordion" id="coursesAccordion">
    {% assign sorted_courses = site.teachings | sort: 'importance' %}
    {% for course in sorted_courses %}
      <div class="card">
        <div class="card-header p-0" id="courseHead{{ forloop.index }}">
          <button
            class="btn btn-link btn-block text-left collapsed d-flex justify-content-between align-items-center"
            type="button"
            data-toggle="collapse"
            data-target="#courseBody{{ forloop.index }}"
            aria-expanded="false"
            aria-controls="courseBody{{ forloop.index }}">
            <span class="course-title font-weight-bold">{{ course.title }}</span>
            {% if course.term %}
              <small class="text-muted ml-2 text-nowrap">{{ course.term }}</small>
            {% endif %}
          </button>
        </div>
        <div
          id="courseBody{{ forloop.index }}"
          class="collapse"
          aria-labelledby="courseHead{{ forloop.index }}"
          data-parent="#coursesAccordion">
          <div class="card-body">
            {% if course.description %}
              <p class="card-text">{{ course.description }}</p>
            {% endif %}
            <a href="{{ course.url | relative_url }}">Course page &rarr;</a>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
{% else %}
  <p>No courses available yet.</p>
{% endif %}
